{
  "name": "eyano-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Eyano API — gestion boutiques, entrepôt, caisse et pilotage (paliers 1–20, cf. docs/PALIERS.md)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "prestart:dev": "prisma generate",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "test:constraints": "tsx prisma/scripts/verify-constraints.ts",
    "prisma:backfill-pricing": "tsx prisma/scripts/backfill-product-pricing-history.ts",
    "prisma:backfill-barcodes": "tsx prisma/scripts/backfill-product-barcodes.ts",
    "prisma:purge-catalog-stores": "tsx prisma/scripts/purge-catalog-and-stores.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "hash-wasm": "^4.13.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
